# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# harness phase execution outputs
phases/**/phase*-output.json
phases/**/step*-output.json

# personal study notes (not a project doc)
docs/RETROSPECT.md

# owasp-security-audit skill output (contains unpatched vuln details)
/security-reports/
.claude/skills/owasp-security-audit-workspace/

# supabase-db-audit skill output (contains unpatched DB advisor details)
/db-reports/

# perf-loop: raw lighthouse JSON + screenshots per run (large, regenerable) —
# RESEARCH_LOG.md itself is tracked
/scripts/perf-loop/reports/
.env.local

# PostHog wizard local cache (regenerable)
.posthog-wizard-cache/
posthog-ai-observability-report.md
.claude/skills/ai-observability-anthropic-node/
.claude/skills/integration-nextjs-app-router/
